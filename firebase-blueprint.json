{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Cấu hình không gian làm việc và quy tắc phân bổ chi phí cố định của người dùng.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID của chủ sở hữu"
        },
        "projectedMonthlyUnits": {
          "type": "number",
          "description": "Sản lượng bán dự kiến / tháng"
        },
        "includeCcdcDepreciation": {
          "type": "boolean",
          "description": "Có tự động cộng khấu hao CCDC hay không"
        },
        "defaultTargetFoodCostPct": {
          "type": "number",
          "description": "Tỉ lệ Food Cost mục tiêu mặc định (%)"
        },
        "defaultPlatformFeePct": {
          "type": "number",
          "description": "Chiết khấu sàn TMĐT mặc định (%)"
        },
        "btpSeeded": {
          "type": "boolean",
          "description": "Đã khởi tạo dữ liệu mẫu Bán thành phẩm"
        },
        "salesTargetPeriod": {
          "type": "string",
          "enum": ["day", "week", "month"],
          "description": "Chu kỳ hiển thị mục tiêu bán hàng"
        },
        "salesTargetMode": {
          "type": "string",
          "enum": ["profit", "units"],
          "description": "Chế độ đặt mục tiêu theo lợi nhuận hoặc sản lượng"
        },
        "salesTargetMonthlyProfit": {
          "type": "number",
          "description": "Mục tiêu lợi nhuận ròng theo tháng (VNĐ)"
        },
        "salesTargetMonthlyUnits": {
          "type": "number",
          "description": "Mục tiêu sản lượng bán ra theo tháng (phần/ly)"
        },
        "estimatedAppCommissionPct": {
          "type": "number",
          "description": "Tỉ lệ chiết khấu sàn tham chiếu (%)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "projectedMonthlyUnits",
        "includeCcdcDepreciation",
        "defaultTargetFoodCostPct",
        "defaultPlatformFeePct",
        "btpSeeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Hàng hóa trong kho gồm Nguyên vật liệu, Bán thành phẩm, Bao bì và Công cụ dụng cụ.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "checked": { "type": "boolean" },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["Nguyên vật liệu", "Bán thành phẩm", "Bao bì", "Công cụ dụng cụ"]
        },
        "qcChan": { "type": "number" },
        "dvtChan": { "type": "string", "minLength": 1, "maxLength": 40 },
        "purchasePrices": {
          "type": "array",
          "description": "Tối đa 9 mức giá nhập"
        },
        "subIngredients": {
          "type": "array",
          "description": "Danh sách thành phần cấu tạo cho Bán thành phẩm (tối đa 50 dòng)"
        },
        "lossRate": { "type": "number" },
        "qcLe": { "type": "number" },
        "dvtLe": { "type": "string", "minLength": 1, "maxLength": 40 },
        "caloPerUnit": { "type": "number" },
        "caloPerRetailUnit": { "type": "number" },
        "depreciationMonths": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "checked",
        "code",
        "name",
        "category",
        "qcChan",
        "dvtChan",
        "purchasePrices",
        "lossRate",
        "qcLe",
        "dvtLe",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "FixedCostItem": {
      "title": "FixedCostItem",
      "description": "Khoản chi phí cố định và mặt bằng hàng tháng.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["Mặt bằng", "Nhân sự cố định", "Điện nước & Vận hành", "Marketing & Khác"]
        },
        "monthlyAmount": { "type": "number" },
        "active": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "monthlyAmount",
        "active",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Món ăn / đồ uống trên menu kèm định lượng nguyên liệu, bao bì và giá bán.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sizeLabel": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 500 },
        "yieldCount": { "type": "number" },
        "ingredients": { "type": "array" },
        "packaging": { "type": "array" },
        "overheadMode": {
          "type": "string",
          "enum": ["auto", "custom", "none"]
        },
        "customOverheadPerUnit": { "type": "number" },
        "platformFeePct": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "estimatedMonthlySales": { "type": "number" },
        "isOnMenu": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "code",
        "name",
        "category",
        "sizeLabel",
        "description",
        "yieldCount",
        "ingredients",
        "packaging",
        "overheadMode",
        "customOverheadPerUnit",
        "platformFeePct",
        "sellingPrice",
        "estimatedMonthlySales",
        "isOnMenu",
        "createdAt",
        "updatedAt"
      ]
    },
    "SalesOrder": {
      "title": "SalesOrder",
      "description": "Đơn bán hàng online tự tạo và tự phân phối giao ship.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "Zalo / Tin nhắn",
            "Facebook / Messenger",
            "Threads",
            "Website đặt trực tiếp",
            "Khách quen / Hotline"
          ]
        },
        "deliveryZone": {
          "type": "string",
          "enum": ["Nội thành (<3km)", "Trung tâm (3–7km)", "Ngoại thành (>7km)"]
        },
        "customerSegment": {
          "type": "string",
          "enum": ["new", "returning"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "cancelled"]
        },
        "items": {
          "type": "array",
          "description": "Danh sách món trong đơn (tối đa 40 dòng)"
        },
        "discountAmount": { "type": "number" },
        "shippingFeeCollected": { "type": "number" },
        "shippingCostActual": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerAddress": { "type": "string", "maxLength": 300 },
        "deliveryDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "deliverySlot": { "type": "string", "maxLength": 40 },
        "carrier": {
          "type": "string",
          "enum": [
            "Tự giao",
            "Xanh SM",
            "Grab Express",
            "Ahamove",
            "Be Delivery",
            "Lalamove",
            "GHTK / GHN",
            "Khác"
          ]
        },
        "carrierTrackingCode": { "type": "string", "maxLength": 80 },
        "paymentMethod": {
          "type": "string",
          "enum": ["transfer", "cod"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "unpaid"]
        },
        "fulfillmentStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "delivering", "completed", "cancelled"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "orderCode",
        "date",
        "source",
        "deliveryZone",
        "customerSegment",
        "status",
        "items",
        "discountAmount",
        "shippingFeeCollected",
        "shippingCostActual",
        "note",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Lưu cấu hình tổng thể, phân bổ chi phí cố định và mục tiêu doanh thu/lợi nhuận của từng người dùng."
    },
    "/users/{userId}/catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Lưu danh mục Nguyên vật liệu, Bán thành phẩm, Bao bì và CCDC của người dùng."
    },
    "/users/{userId}/fixedCosts/{costId}": {
      "schema": { "$ref": "#/entities/FixedCostItem" },
      "description": "Lưu các khoản chi phí cố định và mặt bằng hàng tháng của người dùng."
    },
    "/users/{userId}/menuItems/{menuId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Lưu danh sách món trên menu và định lượng công thức tính giá thành."
    },
    "/users/{userId}/salesOrders/{orderId}": {
      "schema": { "$ref": "#/entities/SalesOrder" },
      "description": "Lưu nhật ký đơn bán hàng online tự tạo và tự giao ship để phân tích doanh thu."
    }
  }
}

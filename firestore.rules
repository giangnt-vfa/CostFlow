rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function hasWorkspace(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // Entity Validators
    function isValidWorkspace(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'projectedMonthlyUnits',
          'includeCcdcDepreciation',
          'defaultTargetFoodCostPct',
          'defaultPlatformFeePct',
          'btpSeeded',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'projectedMonthlyUnits',
          'includeCcdcDepreciation',
          'defaultTargetFoodCostPct',
          'defaultPlatformFeePct',
          'btpSeeded',
          'salesTargetPeriod',
          'salesTargetMode',
          'salesTargetMonthlyProfit',
          'salesTargetMonthlyUnits',
          'estimatedAppCommissionPct',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.projectedMonthlyUnits is number
        && data.projectedMonthlyUnits >= 1
        && data.projectedMonthlyUnits <= 10000000
        && data.includeCcdcDepreciation is bool
        && data.defaultTargetFoodCostPct is number
        && data.defaultTargetFoodCostPct >= 1
        && data.defaultTargetFoodCostPct <= 95
        && data.defaultPlatformFeePct is number
        && data.defaultPlatformFeePct >= 0
        && data.defaultPlatformFeePct <= 80
        && data.btpSeeded is bool
        && (!('salesTargetPeriod' in data) || (data.salesTargetPeriod is string && data.salesTargetPeriod in ['day', 'week', 'month']))
        && (!('salesTargetMode' in data) || (data.salesTargetMode is string && data.salesTargetMode in ['profit', 'units']))
        && (!('salesTargetMonthlyProfit' in data) || (data.salesTargetMonthlyProfit is number && data.salesTargetMonthlyProfit >= 0 && data.salesTargetMonthlyProfit <= 100000000000))
        && (!('salesTargetMonthlyUnits' in data) || (data.salesTargetMonthlyUnits is number && data.salesTargetMonthlyUnits >= 1 && data.salesTargetMonthlyUnits <= 10000000))
        && (!('estimatedAppCommissionPct' in data) || (data.estimatedAppCommissionPct is number && data.estimatedAppCommissionPct >= 0 && data.estimatedAppCommissionPct <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogItem(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'checked',
          'code',
          'name',
          'category',
          'qcChan',
          'dvtChan',
          'purchasePrices',
          'lossRate',
          'qcLe',
          'dvtLe',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'checked',
          'code',
          'name',
          'category',
          'qcChan',
          'dvtChan',
          'purchasePrices',
          'subIngredients',
          'lossRate',
          'qcLe',
          'dvtLe',
          'caloPerUnit',
          'caloPerRetailUnit',
          'depreciationMonths',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.checked is bool
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string
        && data.category in ['Nguyên vật liệu', 'Bán thành phẩm', 'Bao bì', 'Công cụ dụng cụ']
        && data.qcChan is number && data.qcChan > 0 && data.qcChan <= 1000000
        && data.dvtChan is string && data.dvtChan.size() >= 1 && data.dvtChan.size() <= 40
        && data.purchasePrices is list && data.purchasePrices.size() <= 9
        && (data.purchasePrices.size() == 0 || (data.purchasePrices[0] is number && data.purchasePrices[0] >= 0))
        && (!('subIngredients' in data) || (
          data.subIngredients is list
          && data.subIngredients.size() <= 50
          && (data.subIngredients.size() == 0 || data.subIngredients[0] is map)
        ))
        && data.lossRate is number && data.lossRate >= 0 && data.lossRate <= 99
        && data.qcLe is number && data.qcLe > 0 && data.qcLe <= 10000000
        && data.dvtLe is string && data.dvtLe.size() >= 1 && data.dvtLe.size() <= 40
        && (!('caloPerUnit' in data) || (data.caloPerUnit is number && data.caloPerUnit >= 0))
        && (!('caloPerRetailUnit' in data) || (data.caloPerRetailUnit is number && data.caloPerRetailUnit >= 0))
        && (!('depreciationMonths' in data) || (data.depreciationMonths is number && data.depreciationMonths >= 1 && data.depreciationMonths <= 600))
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFixedCost(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'category',
          'monthlyAmount',
          'active',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'category',
          'monthlyAmount',
          'active',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string
        && data.category in ['Mặt bằng', 'Nhân sự cố định', 'Điện nước & Vận hành', 'Marketing & Khác']
        && data.monthlyAmount is number && data.monthlyAmount >= 0 && data.monthlyAmount <= 10000000000
        && data.active is bool
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMenuItem(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'code',
          'name',
          'category',
          'sizeLabel',
          'description',
          'yieldCount',
          'ingredients',
          'packaging',
          'overheadMode',
          'customOverheadPerUnit',
          'platformFeePct',
          'sellingPrice',
          'estimatedMonthlySales',
          'isOnMenu',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'code',
          'name',
          'category',
          'sizeLabel',
          'description',
          'yieldCount',
          'ingredients',
          'packaging',
          'overheadMode',
          'customOverheadPerUnit',
          'platformFeePct',
          'sellingPrice',
          'estimatedMonthlySales',
          'isOnMenu',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.sizeLabel is string && data.sizeLabel.size() <= 60
        && data.description is string && data.description.size() <= 500
        && data.yieldCount is number && data.yieldCount >= 1 && data.yieldCount <= 10000
        && data.ingredients is list && data.ingredients.size() <= 60
        && (data.ingredients.size() == 0 || data.ingredients[0] is map)
        && data.packaging is list && data.packaging.size() <= 30
        && (data.packaging.size() == 0 || data.packaging[0] is map)
        && data.overheadMode is string && data.overheadMode in ['auto', 'custom', 'none']
        && data.customOverheadPerUnit is number && data.customOverheadPerUnit >= 0 && data.customOverheadPerUnit <= 100000000
        && data.platformFeePct is number && data.platformFeePct >= 0 && data.platformFeePct <= 80
        && data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 1000000000
        && data.estimatedMonthlySales is number && data.estimatedMonthlySales >= 0 && data.estimatedMonthlySales <= 10000000
        && data.isOnMenu is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalesOrder(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'orderCode',
          'date',
          'source',
          'deliveryZone',
          'customerSegment',
          'status',
          'items',
          'discountAmount',
          'shippingFeeCollected',
          'shippingCostActual',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'orderCode',
          'date',
          'source',
          'deliveryZone',
          'customerSegment',
          'status',
          'items',
          'discountAmount',
          'shippingFeeCollected',
          'shippingCostActual',
          'note',
          'customerName',
          'customerPhone',
          'customerAddress',
          'deliveryDate',
          'deliverySlot',
          'carrier',
          'carrierTrackingCode',
          'paymentMethod',
          'paymentStatus',
          'fulfillmentStatus',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.orderCode is string && data.orderCode.size() >= 1 && data.orderCode.size() <= 40
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.source is string
        && data.source in ['Zalo / Tin nhắn', 'Facebook / Messenger', 'Threads', 'Website đặt trực tiếp', 'Khách quen / Hotline']
        && data.deliveryZone is string
        && data.deliveryZone in ['Nội thành (<3km)', 'Trung tâm (3–7km)', 'Ngoại thành (>7km)']
        && data.customerSegment is string && data.customerSegment in ['new', 'returning']
        && data.status is string && data.status in ['completed', 'cancelled']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 40
        && data.items[0] is map
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000000
        && data.shippingFeeCollected is number && data.shippingFeeCollected >= 0 && data.shippingFeeCollected <= 10000000
        && data.shippingCostActual is number && data.shippingCostActual >= 0 && data.shippingCostActual <= 10000000
        && data.note is string && data.note.size() <= 500
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 30))
        && (!('customerAddress' in data) || (data.customerAddress is string && data.customerAddress.size() <= 300))
        && (!('deliveryDate' in data) || (data.deliveryDate is string && (data.deliveryDate.size() == 0 || (data.deliveryDate.size() == 10 && data.deliveryDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))))
        && (!('deliverySlot' in data) || (data.deliverySlot is string && data.deliverySlot.size() <= 40))
        && (!('carrier' in data) || (data.carrier is string && data.carrier in ['Tự giao', 'Xanh SM', 'Grab Express', 'Ahamove', 'Be Delivery', 'Lalamove', 'GHTK / GHN', 'Khác']))
        && (!('carrierTrackingCode' in data) || (data.carrierTrackingCode is string && data.carrierTrackingCode.size() <= 80))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod in ['transfer', 'cod']))
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['paid', 'unpaid']))
        && (!('fulfillmentStatus' in data) || (data.fulfillmentStatus is string && data.fulfillmentStatus in ['pending', 'confirmed', 'delivering', 'completed', 'cancelled']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Workspace Root
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'projectedMonthlyUnits',
          'includeCcdcDepreciation',
          'defaultTargetFoodCostPct',
          'defaultPlatformFeePct',
          'btpSeeded',
          'salesTargetPeriod',
          'salesTargetMode',
          'salesTargetMonthlyProfit',
          'salesTargetMonthlyUnits',
          'estimatedAppCommissionPct',
          'updatedAt'
        ]);
      allow delete: if false;

      // Catalog Subcollection (NVL, BTP, BB, CCDC)
      match /catalog/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidCatalogItem(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidCatalogItem(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'checked',
            'code',
            'name',
            'category',
            'qcChan',
            'dvtChan',
            'purchasePrices',
            'subIngredients',
            'lossRate',
            'qcLe',
            'dvtLe',
            'caloPerUnit',
            'caloPerRetailUnit',
            'depreciationMonths',
            'note',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }

      // Fixed Costs Subcollection
      match /fixedCosts/{costId} {
        allow get: if isValidId(userId) && isValidId(costId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(costId)
          && isOwner(userId)
          && isValidFixedCost(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(costId)
          && isOwner(userId)
          && isValidFixedCost(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'category',
            'monthlyAmount',
            'active',
            'note',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(costId) && isOwner(userId);
      }

      // Menu Items Subcollection
      match /menuItems/{menuId} {
        allow get: if isValidId(userId) && isValidId(menuId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(menuId)
          && isOwner(userId)
          && isValidMenuItem(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(menuId)
          && isOwner(userId)
          && isValidMenuItem(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code',
            'name',
            'category',
            'sizeLabel',
            'description',
            'yieldCount',
            'ingredients',
            'packaging',
            'overheadMode',
            'customOverheadPerUnit',
            'platformFeePct',
            'sellingPrice',
            'estimatedMonthlySales',
            'isOnMenu',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(menuId) && isOwner(userId);
      }

      // Direct Online Sales Orders Subcollection
      match /salesOrders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(orderId)
          && isOwner(userId)
          && isValidSalesOrder(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(orderId)
          && isOwner(userId)
          && isValidSalesOrder(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'orderCode',
            'date',
            'source',
            'deliveryZone',
            'customerSegment',
            'status',
            'items',
            'discountAmount',
            'shippingFeeCollected',
            'shippingCostActual',
            'note',
            'customerName',
            'customerPhone',
            'customerAddress',
            'deliveryDate',
            'deliverySlot',
            'carrier',
            'carrierTrackingCode',
            'paymentMethod',
            'paymentStatus',
            'fulfillmentStatus',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
      }
    }
  }
}
